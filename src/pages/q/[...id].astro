---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import QuestionPlayer from '../../components/QuestionPlayer.tsx';
import Aside from '../../components/Aside.astro';
import { getJourney, questionHref } from '../../lib/journey';

export async function getStaticPaths() {
  const chapters = await getJourney();
  return chapters.flatMap((chapter) =>
    chapter.questions.map((question, i) => ({
      params: { id: question.id },
      props: {
        question,
        chapter,
        step: i + 1,
        prev: chapter.questions[i - 1],
        next: chapter.questions[i + 1],
      },
    })),
  );
}

const { question, chapter, step, prev, next } = Astro.props;
const { Content } = await render(question);
const q = question.data;
---

<Layout title={q.title} wide>
  <!-- Reading text stays at a comfortable line length; only the options/trade-offs use the full width. -->
  <div class="max-w-3xl">
  <p class="font-pixel text-sm text-rose">
    {chapter.data.title} · Stop {step} of {chapter.questions.length}
  </p>
  <h1 class="mb-6 text-3xl">{q.title}</h1>

  {q.mock && (
    <p class="mb-6 inline-block bg-twilight px-3 py-1 font-pixel text-xs text-haze">
      Mock question
    </p>
  )}

  <div class="mb-8 border-l-4 border-magenta bg-twilight p-4">
    <p class="mb-1 font-pixel text-sm text-sun">Context</p>
    <ul class="list-disc pl-5 text-sm marker:text-haze">
      {q.constraints.map((c) => <li>{c}</li>)}
    </ul>
  </div>

  <div class="prose prose-sunset mb-8 max-w-none">
    <Content components={{ Aside }} />
  </div>
  </div>

  <QuestionPlayer
    client:load
    questionId={question.id}
    options={q.options}
    itDependsOn={q.itDependsOn}
    flip={q.flip}
    reflection={q.reflection}
  />

  <section class="mt-12 border-t-4 border-dashed border-dusk pt-6">
    <h2 class="mb-2 text-sm text-haze">Read further</h2>
    <ul class="space-y-1 text-sm">
      {
        q.sources.map((s) => (
          <li>
            {s.url ? <a href={s.url} class="text-ember underline underline-offset-4 hover:text-sun">{s.title}</a> : <em>{s.title}</em>}, {s.author}
            {s.location && <span class="text-haze"> ({s.location})</span>}
          </li>
        ))
      }
    </ul>
  </section>

  <nav class="mt-10 flex justify-between gap-4 text-sm">
    {prev ? <a href={questionHref(prev.id)} class="text-ember underline-offset-4 hover:text-sun hover:underline">← {prev.data.title}</a> : <a href="/" class="text-ember underline-offset-4 hover:text-sun hover:underline">← Journey map</a>}
    {next ? <a href={questionHref(next.id)} class="text-ember underline-offset-4 hover:text-sun hover:underline">{next.data.title} →</a> : <a href="/" class="text-ember underline-offset-4 hover:text-sun hover:underline">Back to the map →</a>}
  </nav>
</Layout>
