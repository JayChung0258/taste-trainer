---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!-- Root stays still on navigation; only <main> animates (see "Page-to-page transition" in global.css). -->
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1b1340" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Pixelify+Sans:wght@500;600&display=swap"
    />
    <title>{title === 'Design Taste Trainer' ? title : `${title} · Design Taste Trainer`}</title>
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-night font-sans text-cream antialiased">
    <header class="border-b-4 border-twilight">
      <nav class="mx-auto max-w-3xl px-4 py-4">
        <a href="/" class="inline-flex items-center gap-2 font-pixel text-lg hover:text-sun">
          <span class="inline-block size-3 bg-sun shadow-[0_3px_0_0_var(--color-ember)]" aria-hidden="true"></span>
          Design Taste Trainer
        </a>
      </nav>
    </header>
    <main class="mx-auto max-w-3xl px-4 py-10 [view-transition-name:main]">
      <slot />
    </main>
  </body>
</html>
